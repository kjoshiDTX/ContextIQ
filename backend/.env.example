# ContextIQ Backend Configuration

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# Direct Postgres connection for pgvector (find in Supabase Dashboard > Settings > Database)
SUPABASE_DB_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Neo4j ---
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key

# --- Model Configuration ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_MODEL=gpt-4o-mini

# --- App Settings ---
CHUNK_SIZE_MAX=1000
QUERY_CACHE_TTL_SECONDS=3600
VECTOR_SEARCH_TOP_K=10
RERANK_TOP_K=3
GRAPH_SEARCH_LIMIT=10
